#!/usr/bin/env python3
"""leb — o comando do operador.

Um ciclo de avaliação, quatro passos, uma pasta por instância:

    ./leb pacote    LEB-100-A                      → monta o que vai para o agente
    ./leb avaliar   LEB-100-A runs/.../entrega     → roda o harness na entrega
    ./leb scorecard LEB-100-A <run> --veredito x   → monta o scorecard de 1000 pts
    ./leb estado    [LEB-100-A]                    → o que já foi feito

Tudo de um run vive em runs/<INSTÂNCIA>/ (gitignored). Dentro dela, `pacote/` é a
única pasta que o agente pode ver. Este script só orquestra harness/pack.py,
harness/leb_harness.py e harness/score.py — a lógica está neles.
"""

import argparse
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(ROOT, "harness"))
import instances as inst_lib  # noqa: E402  (the one resolver shared with pack.py, leb_harness.py and export-results.py)

RUNS = inst_lib.runs_dir(ROOT)

BOLD, DIM, OFF = "\033[1m", "\033[2m", "\033[0m"


def diz(msg=""):
    print(msg, file=sys.stderr)


def rel(path):
    """Relative to the repository when inside it, absolute otherwise (a private root or LEB_RUNS_DIR can be anywhere)."""
    path = os.path.abspath(path)
    return os.path.relpath(path, ROOT) if path.startswith(ROOT + os.sep) else path


def instancia(nome):
    """Aceita 'LEB-100-A' ou um caminho para a instância; vê LEB_INSTANCES_PATH (harness/instances.py)."""
    return inst_lib.resolve(nome, ROOT)


def rodar(cmd, capturar=False):
    r = subprocess.run(cmd, cwd=ROOT, text=True,
                       stdout=subprocess.PIPE if capturar else None)
    if r.returncode not in (0, 2):
        sys.exit(r.returncode)
    return r


# --------------------------------------------------------------------- pacote

COMO_RODAR = """# Run — {inst}

> Generated by `./leb pacote {inst}`. This file is yours, the operator's: it does **not** go to the agent.

## 1. What to send

Send **the `pacote/` folder**, and nothing else:

    {pacote}

It holds `code/`, `manifest.md` and `TAREFA.md`. The first message to the agent is exactly this,
the same for every run, with nothing added (PROTOCOL §3):

> Agora leia o TAREFA.md e execute. Devolva code/ alterado, RELATORIO.md e achados.json.

Do not explain the system, do not hint at a category, do not say how many problems there are.

## 2. If the agent stops and waits

Until the delivery is complete, the only thing you may send is this, verbatim, every time
(PROTOCOL §3):

> Não há ninguém para responder. Decida com o seu próprio critério e continue.

Count how many times you sent it: the count goes into `run.json` as `operator_replies`, and each
reply is one turn of the budget. Anything else voids the run: answering its question, a hint, a
correction. Approving a tool-permission prompt is not a reply.

## 3. Write down before you start

| Parameter | Value |
| --- | --- |
| Model + exact version | |
| Temperature | (provider default) |
| Mode | {modo} |
| Turn/token budget | |
| Date | |
| Instance | {inst} v{versao} |
| Matrix (SHA-256) | `{matriz}` |
| Package (SHA-256) | `{pacote_sha}` |
| Operator replies | (count at the end) |
| Usage summary saved as `custo.txt` | (at the end) |

## 4. When it ends: the usage summary

Before closing the client, open its usage summary (Claude Code: `/cost`; another client: its
equivalent) and save it **as printed** to `custo.txt`, next to `entrega/`. Its tokens, the model's
working time and the cost go into `run.json` as `cost_time` (SCORING §9.3). Never use the
wall-clock you measure yourself: it includes every wait for your reply.

## 5. Keep the delivery

One folder per run (3 runs = an official result, no selective retry):

    {base}/<modelo>-1/entrega/     ← code/ + RELATORIO.md + achados.json
    {base}/<modelo>-1/custo.txt    ← the client's usage summary, as printed
    {base}/<modelo>-2/entrega/
    {base}/<modelo>-3/entrega/

## 6. Evaluate

    ./leb avaliar {inst} {base_rel}/<modelo>-1/entrega
    # after the judge (scoring/JUDGE.md → veredito.json):
    ./leb scorecard {inst} <modelo>-1 --veredito <caminho>/veredito.json

Official score = the **median TOTAL** of the 3 runs.
"""


def cmd_pacote(a):
    inst = instancia(a.instancia)
    nome = inst.name
    base = os.path.join(RUNS, nome)
    destino = os.path.join(base, "pacote")

    cmd = [sys.executable, os.path.join("harness", "pack.py"),
           "--instance", inst.root, "--out", rel(destino), "--mode", a.mode]
    if a.turnos:
        cmd += ["--turnos", str(a.turnos)]
    pacote_sha = rodar(cmd, capturar=True).stdout.strip()

    versao, matriz = "n/d", "n/d"
    mpath = inst.matrix_path
    if os.path.exists(mpath):
        with open(mpath, encoding="utf-8") as f:
            m = json.load(f)
        versao = str(m.get("version", "n/d"))
    sha_file = os.path.join(destino, ".leb-pacote.sha256")
    tarefa = os.path.join(destino, "TAREFA.md")
    if os.path.exists(tarefa):
        with open(tarefa, encoding="utf-8") as f:
            for linha in f:
                if "SHA-256" in linha and "`" in linha:
                    matriz = linha.split("`")[1]
                    break

    modo = "S (turno único)" if a.mode == "S" else "A (agêntico · %s turnos)" % a.turnos
    with open(os.path.join(base, "COMO-RODAR.md"), "w", encoding="utf-8") as f:
        f.write(COMO_RODAR.format(inst=nome, pacote=rel(destino), modo=modo, versao=versao,
                                  matriz=matriz, pacote_sha=pacote_sha, base=rel(base),
                                  base_rel=rel(base)))

    diz()
    diz("%sMande esta pasta para o agente:%s" % (BOLD, OFF))
    diz("    %s" % rel(destino))
    diz()
    diz("%sE diga só isto:%s" % (BOLD, OFF))
    diz('    "Leia o TAREFA.md e execute. Devolva code/ alterado, RELATORIO.md e achados.json."')
    diz()
    diz("Receita completa do run (o que anotar, onde salvar, como avaliar):")
    diz("    %s" % rel(os.path.join(base, "COMO-RODAR.md")))
    diz("%s(sha_file: %s)%s" % (DIM, rel(sha_file), OFF))


# -------------------------------------------------------------------- avaliar

def cmd_avaliar(a):
    inst = instancia(a.instancia)
    nome = inst.name
    entrega = os.path.abspath(a.entrega)
    if not os.path.isdir(entrega):
        sys.exit("[leb] entrega não encontrada: %s" % entrega)

    code = os.path.join(entrega, "code") if os.path.isdir(os.path.join(entrega, "code")) else entrega
    if not any(os.path.isfile(os.path.join(code, f)) for f in os.listdir(code)):
        sys.exit("[leb] %s não parece uma pasta code/ (sem arquivos)" % rel(code))

    run = a.label or os.path.basename(os.path.dirname(entrega) if code != entrega else entrega)
    saida = os.path.join(RUNS, nome, run)
    os.makedirs(saida, exist_ok=True)
    mech = os.path.join(saida, "mecanico.json")

    # conferência barata que evita descobrir problema só na hora do juiz
    achados = os.path.join(entrega, "achados.json")
    if os.path.exists(achados):
        try:
            with open(achados, encoding="utf-8") as f:
                d = json.load(f)
            diz("[leb] achados.json ok — %d achado(s)" % len(d.get("achados", [])))
        except json.JSONDecodeError as e:
            diz("[leb] AVISO: achados.json inválido (%s) — o juiz vai ter de usar só o relatório" % e)
    else:
        diz("[leb] AVISO: sem achados.json na entrega — matching manual pelo RELATORIO.md")
    if not os.path.exists(os.path.join(entrega, "RELATORIO.md")):
        diz("[leb] AVISO: sem RELATORIO.md na entrega — sem ele não há C2/EXPL para pontuar")

    r = rodar([sys.executable, os.path.join("harness", "leb_harness.py"),
               "--instance", inst.root, "--submission", rel(code), "--out", rel(mech)])

    diz()
    if r.returncode == 2:
        diz("%s[leb] REGRESSÃO: a entrega quebrou a caracterização.%s" % (BOLD, OFF))
    diz("Mecânico → %s" % rel(mech))
    diz()
    diz("%sPróximo passo — o juiz%s (scoring/JUDGE.md): leia RELATORIO.md + achados.json contra a" % (BOLD, OFF))
    diz("matriz e produza o veredito no formato scoring/judge.schema.json. Depois:")
    diz("    ./leb scorecard %s %s --veredito <caminho>/veredito.json" % (nome, run))


# ------------------------------------------------------------------ scorecard

def cmd_scorecard(a):
    inst = instancia(a.instancia)
    nome = inst.name
    saida = os.path.join(RUNS, nome, a.run)
    mech = os.path.join(saida, "mecanico.json")
    if not os.path.exists(mech):
        sys.exit("[leb] falta o relatório mecânico: %s (rode ./leb avaliar antes)" % rel(mech))
    matriz = inst.matrix_path
    if not os.path.exists(matriz):
        sys.exit("[leb] esta instância não tem private/matrix.json — sem gabarito não há scorecard")

    card = os.path.join(saida, "scorecard.json")
    cmd = [sys.executable, os.path.join("harness", "score.py"),
           "--matrix", rel(matriz), "--mechanical", rel(mech),
           "--judge", os.path.abspath(a.veredito), "--out", rel(card)]
    if a.custo:
        cmd += ["--cost", os.path.abspath(a.custo)]
    rodar(cmd)
    diz()
    diz("Scorecard → %s" % rel(card))
    diz("Oficial = mediana do TOTAL de 3 execuções (PROTOCOL §4). Veja ./leb estado %s" % nome)


# --------------------------------------------------------------------- estado

def cmd_estado(a):
    alvos = [a.instancia] if a.instancia else sorted(
        d for d in os.listdir(RUNS) if os.path.isdir(os.path.join(RUNS, d))) if os.path.isdir(RUNS) else []
    if not alvos:
        diz("[leb] nenhum run ainda. Comece com: ./leb pacote LEB-100-A")
        return
    for nome in alvos:
        base = os.path.join(RUNS, instancia(nome).name)
        if not os.path.isdir(base):
            diz("%s — nenhum run" % nome)
            continue
        diz("%s%s%s  (%s)" % (BOLD, os.path.basename(base), OFF, rel(base)))
        pacote = os.path.join(base, "pacote")
        diz("  pacote     %s" % ("montado" if os.path.isdir(pacote) else "— (./leb pacote)"))
        for run in sorted(d for d in os.listdir(base) if os.path.isdir(os.path.join(base, d)) and d != "pacote"):
            r = os.path.join(base, run)
            etapas = []
            etapas.append("mecânico" if os.path.exists(os.path.join(r, "mecanico.json")) else "—")
            etapas.append("scorecard" if os.path.exists(os.path.join(r, "scorecard.json")) else "—")
            total = ""
            card = os.path.join(r, "scorecard.json")
            if os.path.exists(card):
                try:
                    with open(card, encoding="utf-8") as f:
                        total = "  TOTAL %s" % json.load(f).get("total", "?")
                except (json.JSONDecodeError, OSError):
                    pass
            diz("  %-10s %s%s" % (run, " · ".join(etapas), total))


def cmd_instancias(_):
    for inst in inst_lib.list_instances(ROOT):
        diz(inst.name)


def main():
    ap = argparse.ArgumentParser(
        prog="leb", description="operador do LEB — um ciclo de avaliação, quatro comandos",
        epilog="ciclo: pacote → (agente) → avaliar → (juiz) → scorecard · 3× → mediana")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("pacote", help="monta a pasta que vai para o agente")
    p.add_argument("instancia")
    p.add_argument("--mode", choices=["S", "A"], default="S")
    p.add_argument("--turnos", type=int)
    p.set_defaults(fn=cmd_pacote)

    p = sub.add_parser("avaliar", help="roda o harness mecânico na entrega do agente")
    p.add_argument("instancia")
    p.add_argument("entrega", help="pasta da entrega (com code/ dentro, ou o próprio code/)")
    p.add_argument("--label", help="nome do run (default: nome da pasta)")
    p.set_defaults(fn=cmd_avaliar)

    p = sub.add_parser("scorecard", help="junta mecânico + veredito do juiz → 1000 pontos")
    p.add_argument("instancia")
    p.add_argument("run")
    p.add_argument("--veredito", required=True, help="JSON do juiz (scoring/judge.schema.json)")
    p.add_argument("--custo", help="JSON com o bloco cost_time (opcional)")
    p.set_defaults(fn=cmd_scorecard)

    p = sub.add_parser("estado", help="o que já foi montado, avaliado e pontuado")
    p.add_argument("instancia", nargs="?")
    p.set_defaults(fn=cmd_estado)

    p = sub.add_parser("instancias", help="lista as instâncias disponíveis")
    p.set_defaults(fn=cmd_instancias)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
