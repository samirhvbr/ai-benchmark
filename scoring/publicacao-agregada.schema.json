{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leb.dev/schemas/publicacao-agregada.schema.json",
  "title": "Aggregate-only publication of an ACTIVE instance (E7)",
  "description": "What may be published while the instance is active. There is deliberately no field for flaws, per-occurrence results, judge rationale, deliveries, reports or test names. The full LEB (LEB-100, LEB-300) publishes the lower median of up to three runs; the new series (a `track` is present) publishes the estimate of its five runs with its interval (docs/new-series-design.md section 9).",
  "type": "object",
  "required": [
    "agents",
    "edition",
    "instance",
    "leb_spec",
    "level",
    "matrix_sha256",
    "mode",
    "publication",
    "task_version",
    "version"
  ],
  "properties": {
    "instance": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "level": {
      "type": "integer"
    },
    "leb_spec": {
      "type": "string"
    },
    "task_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "matrix_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "S",
        "A"
      ]
    },
    "turn_budget": {
      "type": [
        "integer",
        "null"
      ]
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "score",
          "grade",
          "categories",
          "runs_count"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "grade": {
            "type": "string",
            "enum": [
              "Platinum",
              "Gold",
              "Silver",
              "Bronze",
              "Reprovada"
            ]
          },
          "runs_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "categories": {
            "type": "object",
            "required": [
              "ARCH",
              "BUG",
              "PERF",
              "CLN",
              "COMP",
              "EXPL"
            ],
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "wall_minutes": {
            "type": [
              "number",
              "null"
            ]
          },
          "tokens": {
            "description": "The client's own token counts of the run: input without the part served from the cache, output with the reasoning tokens, cache read plus written, and the total. Null when the run record lacks them.",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "input",
              "output",
              "cache",
              "total"
            ],
            "properties": {
              "input": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "integer",
                "minimum": 0
              },
              "cache": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "runs": {
            "type": "array",
            "description": "One line per run of the agent, by run number: its total, its cost, its session time and its tokens. The same numbers the score is the lower median of.",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "run",
                "total"
              ],
              "properties": {
                "run": {
                  "type": "integer",
                  "minimum": 1
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "cost_usd": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "wall_minutes": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "tokens": {
                  "description": "The client's own token counts of the run: input without the part served from the cache, output with the reasoning tokens, cache read plus written, and the total. Null when the run record lacks them.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "input",
                    "output",
                    "cache",
                    "total"
                  ],
                  "properties": {
                    "input": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "output": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cache": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                },
                "grade": {
                  "type": "string",
                  "enum": [
                    "Platinum",
                    "Gold",
                    "Silver",
                    "Bronze",
                    "Reprovada"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "comment": {
            "type": "object",
            "description": "A short written reading of the agent in the site's two languages. Free text is the one place a flaw could leak, so the exporter refuses any flaw id or any long text of the matrix in it.",
            "required": [
              "en",
              "pt_BR"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200,
                "pattern": "^[\\s\\S]{1,1200}$"
              },
              "pt_BR": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200,
                "pattern": "^[\\s\\S]{1,1200}$"
              }
            },
            "additionalProperties": false
          },
          "model": {
            "type": "object",
            "description": "Who the agent is, as its run record says (the same public block LEB-100 publishes): the sites show it when LEB-100 has no run of this agent.",
            "required": [
              "name",
              "provider",
              "reasoning_effort"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "reasoning_effort": {
                "type": "string"
              },
              "client_mode": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "category_max": {
            "type": "object",
            "description": "New series: the most each category can give on the track, so a reader can read the categories against it.",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "statistics": {
            "type": "object",
            "description": "New series: the figures of docs/new-series-design.md section 9 for this configuration on this track. The score above is the mean of quality, rounded.",
            "required": [
              "scheduled",
              "quality",
              "expected_per_scheduled_attempt",
              "completion",
              "outcomes"
            ],
            "properties": {
              "scheduled": {
                "type": "integer",
                "minimum": 1
              },
              "quality": {
                "type": "object",
                "required": [
                  "n",
                  "systems",
                  "mean",
                  "low",
                  "high"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "systems": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mean": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "description": "Mean score of the evaluable deliveries (completed attempts) with its 95% percentile-bootstrap interval, resampling systems and runs."
              },
              "expected_per_scheduled_attempt": {
                "type": "object",
                "required": [
                  "n",
                  "systems",
                  "mean",
                  "low",
                  "high"
                ],
                "properties": {
                  "n": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "systems": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mean": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "description": "Mean score over every scheduled attempt, a blocked or exhausted one with the score of the folder it left."
              },
              "completion": {
                "type": "object",
                "required": [
                  "rate",
                  "completed",
                  "scheduled",
                  "systems_all_completed",
                  "systems"
                ],
                "properties": {
                  "rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "completed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "scheduled": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "systems_all_completed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "systems": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              },
              "outcomes": {
                "type": "object",
                "required": [
                  "completed",
                  "blocked",
                  "blocked_at_the_start",
                  "blocked_during_the_work",
                  "budget_exhausted",
                  "switched"
                ],
                "properties": {
                  "completed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked_at_the_start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "blocked_during_the_work": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "budget_exhausted": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "switched": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "lab_failures_rerun": {
                "type": "integer",
                "minimum": 0,
                "description": "Attempts lost to the lab or to the operator before the model could deliver, not scored and rerun under the rule of design 6.2."
              },
              "median": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "additionalProperties": false
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "New series: the package this configuration's runs received. The instance's own package_sha256 is present only when every configuration received the same one."
          }
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "const": "aggregate"
    },
    "edition": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "track": {
      "description": "The track of the new series this instance belongs to; absent on the full LEB.",
      "enum": [
        "default",
        "security"
      ]
    },
    "budget_minutes": {
      "description": "The wall-clock budget of one run in the new series, which has no turn budget.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "notes": {
      "type": "object",
      "description": "What a reader needs to know about how this instance was run, in the site's two languages. Free text is the one place a flaw could leak, so the exporter refuses any flaw id or any long text of the matrix in it.",
      "required": [
        "en",
        "pt_BR"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "pt_BR": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
